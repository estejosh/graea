GRAEA_API_ID=
GRAEA_API_HASH=
GRAEA_PHONE=
GRAEA_BOT=@your_bot
# who reads the screenshots: caller (the LLM driving Graea reads the image itself, default),
# openai_compatible (Ollama/vLLM/LM Studio/OpenRouter/OpenAI), anthropic, ocr, none
GRAEA_VISION_PROVIDER=caller
GRAEA_VISION_BASE_URL=http://localhost:11434/v1
# inside the podman container the host's Ollama is reachable as:
# GRAEA_VISION_BASE_URL=http://host.containers.internal:11434/v1
GRAEA_VISION_MODEL=llama3.2-vision
GRAEA_VISION_API_KEY=ollama
GRAEA_WEB_HEADLESS=true
